# Local .terraform directories across modules and environments
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive tfvars and auto-generated overrides
secrets.auto.tfvars
*.auto.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Allow example tfvars templates to be committed
!*.example

# Include provider lockfile per HashiCorp best practice
!**/.terraform.lock.hcl

# OS & IDE temporary files
.DS_Store
.vscode/
.idea/
*.swp
*.tmp
