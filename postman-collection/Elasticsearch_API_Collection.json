		{
			"name": "02. Index Management",
			"item": [
				{
					"name": "2.1 Create Index with Mappings & Settings",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"settings\": {\n    \"number_of_shards\": 1,\n    \"number_of_replicas\": 0\n  },\n  \"mappings\": {\n    \"properties\": {\n      \"service\": { \"type\": \"keyword\" },\n      \"status\": { \"type\": \"keyword\" },\n      \"latency_ms\": { \"type\": \"integer\" },\n      \"timestamp\": { \"type\": \"date\" },\n      \"message\": { \"type\": \"text\" }\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/app-logs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"app-logs"
							]
						},
						"description": "Creates a new index named 'app-logs' with explicit mappings and single-shard settings."
					},
					"response": []
				},
				{
					"name": "2.2 Get Index Details",
					"request": {
