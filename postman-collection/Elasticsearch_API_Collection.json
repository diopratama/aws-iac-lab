						"body": {
							"mode": "raw",
							"raw": "{\n  \"size\": 0,\n  \"aggs\": {\n    \"by_status\": {\n      \"terms\": {\n        \"field\": \"status\"\n      }\n    },\n    \"avg_latency\": {\n      \"avg\": {\n        \"field\": \"latency_ms\"\n      }\n    }\n  }\n}"
