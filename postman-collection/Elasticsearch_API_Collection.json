						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": {\n    \"range\": {\n      \"latency_ms\": {\n        \"gte\": 50,\n        \"lte\": 200\n      }\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/app-logs/_search",
							"host": [
								"{{base_url}}"
